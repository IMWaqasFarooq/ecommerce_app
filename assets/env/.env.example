# Copy this file to .env.development / .env.production and fill in real values.
# These files are gitignored and must never be committed.

# DummyJSON public product API. Free, no key required.
API_BASE_URL=https://dummyjson.com

# Stripe *publishable* key only - safe to embed client-side, starts with pk_test_/pk_live_.
# Never put a secret key (sk_...) in this file or anywhere in the Flutter app.
STRIPE_PUBLISHABLE_KEY=

# HTTPS endpoint of the createPaymentIntent Cloud Function (see /functions).
PAYMENTS_FUNCTION_URL=

NETWORK_RETRY_BASE_DELAY_MS=500
NETWORK_MAX_RETRIES=3
NETWORK_CONNECT_TIMEOUT_MS=15000
NETWORK_RECEIVE_TIMEOUT_MS=15000

ENABLE_NETWORK_LOGGING=true
